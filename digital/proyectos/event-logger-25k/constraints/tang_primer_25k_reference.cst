// ============================================================
// Tang Primer 25K (GW5A-25) - Event Logger Constraints
// ============================================================
// Basado en el esquematico de la core board + dock base
// ============================================================
// Revision: Core board rev 1.1, Dock rev 1.0
// Reloj: 27 MHz desde oscilador onboard
// VCCIO: 3.3V (LEDs, botones, switches, display)
// Polaridad botones: activos en bajo (pull-up interno)
// Polaridad LEDs: activos en alto
// Polaridad display 7seg: catodo comun, segmentos activos en bajo
// ============================================================

// --- Reloj principal ---
IO_LOC  "i_clk"      78;   // Pin 78 - CLK_IN de oscilador 27MHz
IO_PORT "i_clk"       IO_TYPE=LVCMOS33;

// --- Reset (boton en dock) ---
IO_LOC  "i_rst_n"    34;   // BTN_N (activo en bajo)
IO_PORT "i_rst_n"     IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- Botones (dock base, activos en bajo) ---
IO_LOC  "i_button[0]" 35;  // BTN_0 - Arm
IO_LOC  "i_button[1]" 36;  // BTN_1 - Capture
IO_LOC  "i_button[2]" 37;  // BTN_2 - TX
IO_LOC  "i_button[3]" 38;  // BTN_3 - Clear
IO_PORT "i_button[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "i_button[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "i_button[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "i_button[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- Switches (dock base) ---
IO_LOC  "i_switch[0]" 39;
IO_LOC  "i_switch[1]" 40;
IO_LOC  "i_switch[2]" 41;
IO_LOC  "i_switch[3]" 42;
IO_PORT "i_switch[0]" IO_TYPE=LVCMOS33;
IO_PORT "i_switch[1]" IO_TYPE=LVCMOS33;
IO_PORT "i_switch[2]" IO_TYPE=LVCMOS33;
IO_PORT "i_switch[3]" IO_TYPE=LVCMOS33;

// --- LEDs (dock base, activos en alto) ---
IO_LOC  "o_led[0]"    43;
IO_LOC  "o_led[1]"    44;
IO_LOC  "o_led[2]"    45;
IO_LOC  "o_led[3]"    46;
IO_LOC  "o_led[4]"    47;
IO_LOC  "o_led[5]"    48;
IO_LOC  "o_led[6]"    49;
IO_LOC  "o_led[7]"    50;
IO_PORT "o_led[0]" IO_TYPE=LVCMOS33;
IO_PORT "o_led[1]" IO_TYPE=LVCMOS33;
IO_PORT "o_led[2]" IO_TYPE=LVCMOS33;
IO_PORT "o_led[3]" IO_TYPE=LVCMOS33;
IO_PORT "o_led[4]" IO_TYPE=LVCMOS33;
IO_PORT "o_led[5]" IO_TYPE=LVCMOS33;
IO_PORT "o_led[6]" IO_TYPE=LVCMOS33;
IO_PORT "o_led[7]" IO_TYPE=LVCMOS33;

// --- Display 7 segmentos (dock base) ---
// Segmentos: A B C D E F G (orden seg[6:0])
IO_LOC  "o_seg[0]"    51;  // G
IO_LOC  "o_seg[1]"    52;  // F
IO_LOC  "o_seg[2]"    53;  // E
IO_LOC  "o_seg[3]"    54;  // D
IO_LOC  "o_seg[4]"    55;  // C
IO_LOC  "o_seg[5]"    56;  // B
IO_LOC  "o_seg[6]"    57;  // A
IO_PORT "o_seg[0]" IO_TYPE=LVCMOS33;
IO_PORT "o_seg[1]" IO_TYPE=LVCMOS33;
IO_PORT "o_seg[2]" IO_TYPE=LVCMOS33;
IO_PORT "o_seg[3]" IO_TYPE=LVCMOS33;
IO_PORT "o_seg[4]" IO_TYPE=LVCMOS33;
IO_PORT "o_seg[5]" IO_TYPE=LVCMOS33;
IO_PORT "o_seg[6]" IO_TYPE=LVCMOS33;

// --- Selector de display (activo en alto selecciona digito) ---
IO_LOC  "o_sel"       58;
IO_PORT "o_sel"       IO_TYPE=LVCMOS33;

// --- UART TX (GPIO del dock o PMOD, confirmar con docente) ---
// Pin asignado temporalmente a PMOD JA[0] (GPIO 60)
IO_LOC  "o_uart_tx"   60;
IO_PORT "o_uart_tx"   IO_TYPE=LVCMOS33;
